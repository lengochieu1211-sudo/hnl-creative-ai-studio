# Secure backend mode (npm run dev / npm run build + npm start)
# Keep this secret on the server. Never commit a real key.
GEMINI_API_KEY=

# Optional: point a static web build to a secure HNL API proxy.
# Leave blank for GitHub Pages BYOK mode.
VITE_AI_API_BASE=

# Optional runtime metadata.
VITE_APP_VERSION=1.1.0

# Optional comma-separated frontend origins when backend is hosted separately.
# Example: https://your-user.github.io,https://creative.example.com
HNL_ALLOWED_ORIGINS=

# Optional production port (default 3000).
PORT=3000
